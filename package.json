{
  "name": "vscode-visual-html-designer",
  "displayName": "VSCode File Editor",
  "description": "Edit HTML visually and modify text in PowerPoint presentations in Visual Studio Code.",
  "version": "0.2.12",
  "publisher": "pengsen",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:htmlDesign.open",
    "onCustomEditor:fileEditor.html",
    "onCustomEditor:fileEditor.powerpoint",
    "onCommand:fileEditor.openPowerPoint"
  ],
  "contributes": {
    "commands": [
      {
        "command": "htmlDesign.open",
        "title": "HTML Editor: Open Design View",
        "icon": "$(preview)"
      },
      {
        "command": "fileEditor.openPowerPoint",
        "title": "PowerPoint Editor: Open Presentation"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "htmlDesign.open",
          "when": "editorLangId == html",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "fileEditor.openPowerPoint",
          "when": "resourceExtname =~ /^\\.pptx$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VSCode File Editor",
      "properties": {
        "htmlDesign.syncDelay": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "description": "Delay in milliseconds before visual changes are applied to the HTML source.",
          "scope": "resource"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "fileEditor.html",
        "displayName": "VSCode File Editor (HTML)",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "fileEditor.powerpoint",
        "displayName": "PowerPoint Editor",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "diff": "^8.0.0",
    "fflate": "^0.8.3",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapengsen/VSCode-File-Editor.git"
  },
  "homepage": "https://github.com/mapengsen/VSCode-File-Editor#readme",
  "bugs": {
    "url": "https://github.com/mapengsen/VSCode-File-Editor/issues"
  },
  "keywords": [
    "html",
    "wysiwyg",
    "visual editor",
    "html editor",
    "remote ssh",
    "powerpoint",
    "pptx"
  ]
}
